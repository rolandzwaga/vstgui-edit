{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://steinbergmedia.github.io/vstgui/uidesc.schema.json",
  "title": "VSTGUI UI Description",
  "description": "Schema for VSTGUI uidesc JSON format - declarative UI definition for VST3 plugins. Generated from VSTGUI4 source code.",
  "type": "object",
  "required": ["vstgui-ui-description"],
  "properties": {
    "vstgui-ui-description": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "enum": ["1"],
          "description": "VSTGUI UI Description format version"
        },
        "colors": {
          "$ref": "#/$defs/colorsDefinition"
        },
        "fonts": {
          "$ref": "#/$defs/fontsDefinition"
        },
        "bitmaps": {
          "$ref": "#/$defs/bitmapsDefinition"
        },
        "gradients": {
          "$ref": "#/$defs/gradientsDefinition"
        },
        "control-tags": {
          "$ref": "#/$defs/controlTagsDefinition"
        },
        "variables": {
          "$ref": "#/$defs/variablesDefinition"
        },
        "templates": {
          "$ref": "#/$defs/templatesDefinition"
        },
        "custom": {
          "$ref": "#/$defs/customDefinition"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "colorValue": {
      "type": "string",
      "description": "Color value: hex (#RRGGBBAA or #RRGGBB), color name reference, or predefined (~BlackCColor)",
      "pattern": "^(#[0-9a-fA-F]{6,8}|~[A-Za-z][A-Za-z0-9]*|var\\.[A-Za-z_][A-Za-z0-9_]*|[A-Za-z][A-Za-z0-9_-]*)$"
    },
    "pointValue": {
      "type": "string",
      "description": "Point value: 'x, y' coordinates",
      "pattern": "^-?\\d+(\\.\\d+)?\\s*,\\s*-?\\d+(\\.\\d+)?$"
    },
    "sizeValue": {
      "type": "string",
      "description": "Size value: 'width, height'",
      "pattern": "^\\d+(\\.\\d+)?\\s*,\\s*\\d+(\\.\\d+)?$"
    },
    "rectValue": {
      "type": "string",
      "description": "Rectangle value: 'left, top, right, bottom'",
      "pattern": "^-?\\d+(\\.\\d+)?\\s*,\\s*-?\\d+(\\.\\d+)?\\s*,\\s*-?\\d+(\\.\\d+)?\\s*,\\s*-?\\d+(\\.\\d+)?$"
    },
    "booleanValue": {
      "type": "string",
      "enum": ["true", "false"],
      "description": "Boolean value as string"
    },
    "numericValue": {
      "type": "string",
      "description": "Numeric value (integer or float)",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "autosizeValue": {
      "type": "string",
      "description": "Autosize anchors: combination of 'left', 'right', 'top', 'bottom', 'row', 'column'"
    },
    "colorsDefinition": {
      "type": "object",
      "description": "Color definitions",
      "additionalProperties": {
        "$ref": "#/$defs/colorValue"
      }
    },
    "fontDefinition": {
      "type": "object",
      "description": "Font definition",
      "required": ["font-name", "size"],
      "properties": {
        "font-name": {
          "type": "string",
          "description": "System font name (e.g., 'Arial', 'Helvetica')"
        },
        "size": {
          "$ref": "#/$defs/numericValue",
          "description": "Font size in points"
        },
        "bold": {
          "$ref": "#/$defs/booleanValue"
        },
        "italic": {
          "$ref": "#/$defs/booleanValue"
        },
        "underline": {
          "$ref": "#/$defs/booleanValue"
        },
        "strike-through": {
          "$ref": "#/$defs/booleanValue"
        },
        "alternative-font-names": {
          "type": "string",
          "description": "Comma-separated fallback font names"
        }
      },
      "additionalProperties": false
    },
    "fontsDefinition": {
      "type": "object",
      "description": "Font definitions",
      "additionalProperties": {
        "$ref": "#/$defs/fontDefinition"
      }
    },
    "bitmapData": {
      "type": "object",
      "description": "Embedded bitmap data",
      "required": ["encoding", "data"],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": ["base64"],
          "description": "Data encoding format"
        },
        "data": {
          "type": "string",
          "description": "Base64-encoded image data"
        }
      },
      "additionalProperties": false
    },
    "bitmapDefinition": {
      "type": "object",
      "description": "Bitmap definition",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "File path relative to uidesc location"
        },
        "scale-factor": {
          "$ref": "#/$defs/numericValue",
          "description": "DPI scale factor (1, 1.5, 2, etc.)"
        },
        "nineparttiled-offsets": {
          "type": "string",
          "description": "Nine-part tiling offsets: 'top, left, bottom, right'",
          "pattern": "^\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+$"
        },
        "multiframe-num-frames": {
          "$ref": "#/$defs/numericValue",
          "description": "Total number of frames in the multiframe bitmap"
        },
        "multiframe-size": {
          "type": "string",
          "description": "Size of each frame: 'width, height'",
          "pattern": "^\\d+(\\.\\d+)?\\s*,\\s*\\d+(\\.\\d+)?$"
        },
        "mulitframe-frames-per-row": {
          "$ref": "#/$defs/numericValue",
          "description": "Number of frames per row for grid layouts (note: typo matches VSTGUI)"
        },
        "data": {
          "$ref": "#/$defs/bitmapData"
        }
      },
      "additionalProperties": false
    },
    "bitmapsDefinition": {
      "type": "object",
      "description": "Bitmap definitions",
      "additionalProperties": {
        "$ref": "#/$defs/bitmapDefinition"
      }
    },
    "gradientColorStop": {
      "type": "object",
      "description": "Gradient color stop",
      "required": ["rgba", "start"],
      "properties": {
        "rgba": {
          "$ref": "#/$defs/colorValue",
          "description": "Color at this stop"
        },
        "start": {
          "$ref": "#/$defs/numericValue",
          "description": "Stop position (0.0 to 1.0)"
        }
      },
      "additionalProperties": false
    },
    "gradientDefinition": {
      "type": "array",
      "description": "Gradient definition as array of color stops",
      "items": {
        "$ref": "#/$defs/gradientColorStop"
      },
      "minItems": 2
    },
    "gradientsDefinition": {
      "type": "object",
      "description": "Gradient definitions",
      "additionalProperties": {
        "$ref": "#/$defs/gradientDefinition"
      }
    },
    "controlTagValue": {
      "type": "string",
      "description": "Control tag: numeric ID, string tag ('name'), or expression"
    },
    "controlTagsDefinition": {
      "type": "object",
      "description": "Control tag mappings (name -> parameter ID)",
      "additionalProperties": {
        "$ref": "#/$defs/controlTagValue"
      }
    },
    "variablesDefinition": {
      "type": "object",
      "description": "Variable definitions (name -> value)",
      "additionalProperties": {
        "type": "string"
      }
    },

    "CViewAttributes": {
      "type": "object",
      "description": "CView - Base view attributes (all views inherit these)",
      "properties": {
        "class": { "type": "string", "description": "View class name" },
        "origin": { "$ref": "#/$defs/pointValue", "description": "Top-left corner position 'x, y'" },
        "size": { "$ref": "#/$defs/pointValue", "description": "View dimensions 'width, height'" },
        "opacity": { "$ref": "#/$defs/numericValue", "description": "View opacity (0.0 to 1.0)" },
        "transparent": { "$ref": "#/$defs/booleanValue", "description": "If true, view is transparent to mouse events" },
        "mouse-enabled": { "$ref": "#/$defs/booleanValue", "description": "If true, view responds to mouse events" },
        "wants-focus": { "$ref": "#/$defs/booleanValue", "description": "If true, view can receive keyboard focus" },
        "bitmap": { "type": "string", "description": "Background bitmap reference" },
        "disabled-bitmap": { "type": "string", "description": "Disabled state background bitmap reference" },
        "autosize": { "$ref": "#/$defs/autosizeValue", "description": "Autosize flags: left, right, top, bottom, row, column" },
        "tooltip": { "type": "string", "description": "Tooltip text shown on hover" },
        "custom-view-name": { "type": "string", "description": "Custom view name for factory lookup" },
        "sub-controller": { "type": "string", "description": "Sub-controller name" },
        "uidesc-label": { "type": "string", "description": "Label for identification in editor" }
      }
    },

    "CViewContainerAttributes": {
      "type": "object",
      "description": "CViewContainer - Container view attributes (inherits from CView)",
      "allOf": [{ "$ref": "#/$defs/CViewAttributes" }],
      "properties": {
        "background-color": { "$ref": "#/$defs/colorValue", "description": "Background fill color" },
        "background-color-draw-style": {
          "type": "string",
          "enum": ["stroked", "filled", "filled and stroked"],
          "description": "How background color is drawn"
        }
      }
    },

    "CLayeredViewContainerAttributes": {
      "type": "object",
      "description": "CLayeredViewContainer - Layered container (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "z-index": { "$ref": "#/$defs/numericValue", "description": "Z-order index for layering" }
      }
    },

    "CRowColumnViewAttributes": {
      "type": "object",
      "description": "CRowColumnView - Row/column layout container (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "row-style": { "$ref": "#/$defs/booleanValue", "description": "If true, arrange children in row; if false, in column" },
        "spacing": { "$ref": "#/$defs/numericValue", "description": "Spacing between children in pixels" },
        "margin": { "$ref": "#/$defs/rectValue", "description": "Margins: 'left, top, right, bottom'" },
        "animate-view-resizing": { "$ref": "#/$defs/booleanValue", "description": "Animate view resize changes" },
        "hide-clipped-subviews": { "$ref": "#/$defs/booleanValue", "description": "Hide subviews that are clipped" },
        "equal-size-layout": {
          "type": "string",
          "enum": ["left-top", "center", "right-bottom", "stretch", "top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"],
          "description": "Layout style for equal-sized children"
        },
        "view-resize-animation-time": { "$ref": "#/$defs/numericValue", "description": "Animation duration in milliseconds" }
      }
    },

    "CScrollViewAttributes": {
      "type": "object",
      "description": "CScrollView - Scrollable container (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "container-size": { "$ref": "#/$defs/pointValue", "description": "Scrollable content size 'width, height'" },
        "scrollbar-background-color": { "$ref": "#/$defs/colorValue", "description": "Scrollbar background color" },
        "scrollbar-frame-color": { "$ref": "#/$defs/colorValue", "description": "Scrollbar frame color" },
        "scrollbar-scroller-color": { "$ref": "#/$defs/colorValue", "description": "Scrollbar thumb color" },
        "horizontal-scrollbar": { "$ref": "#/$defs/booleanValue", "description": "Show horizontal scrollbar" },
        "vertical-scrollbar": { "$ref": "#/$defs/booleanValue", "description": "Show vertical scrollbar" },
        "auto-hide-scrollbars": { "$ref": "#/$defs/booleanValue", "description": "Auto-hide scrollbars when not needed" },
        "auto-drag-scrolling": { "$ref": "#/$defs/booleanValue", "description": "Enable drag scrolling" },
        "overlay-scrollbars": { "$ref": "#/$defs/booleanValue", "description": "Scrollbars overlay content" },
        "scrollbar-width": { "$ref": "#/$defs/numericValue", "description": "Scrollbar width in pixels" },
        "scrollbar-min-scroller-size": { "$ref": "#/$defs/numericValue", "description": "Minimum scrollbar thumb size" },
        "bordered": { "$ref": "#/$defs/booleanValue", "description": "Draw border around scroll view" },
        "follow-focus-view": { "$ref": "#/$defs/booleanValue", "description": "Auto-scroll to focused view" }
      }
    },

    "UIViewSwitchContainerAttributes": {
      "type": "object",
      "description": "UIViewSwitchContainer - Template switching container (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "template-names": { "type": "string", "description": "Comma-separated list of template names" },
        "template-switch-control": { "type": "string", "description": "Control tag that switches templates" },
        "animation-style": {
          "type": "string",
          "enum": ["fade", "move", "push"],
          "description": "Transition animation style"
        },
        "animation-timing-function": {
          "type": "string",
          "enum": ["linear", "easy-in", "easy-out", "easy-in-out", "easy"],
          "description": "Animation easing function"
        },
        "animation-time": { "$ref": "#/$defs/numericValue", "description": "Animation duration in milliseconds" }
      }
    },

    "CSplitViewAttributes": {
      "type": "object",
      "description": "CSplitView - Resizable split container (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "description": "Split orientation"
        },
        "resize-method": {
          "type": "string",
          "enum": ["first", "second", "last", "all"],
          "description": "Which view(s) resize when container resizes"
        },
        "separator-width": { "$ref": "#/$defs/numericValue", "description": "Separator width in pixels" }
      }
    },

    "CShadowViewContainerAttributes": {
      "type": "object",
      "description": "CShadowViewContainer - Container with shadow effect (inherits from CViewContainer)",
      "allOf": [{ "$ref": "#/$defs/CViewContainerAttributes" }],
      "properties": {
        "shadow-intensity": { "$ref": "#/$defs/numericValue", "description": "Shadow opacity (0.0 to 1.0)" },
        "shadow-offset": { "$ref": "#/$defs/pointValue", "description": "Shadow offset 'x, y'" },
        "shadow-blur-size": { "$ref": "#/$defs/numericValue", "description": "Shadow blur radius (0.8 to 20)" }
      }
    },

    "CControlAttributes": {
      "type": "object",
      "description": "CControl - Base control attributes (inherits from CView)",
      "allOf": [{ "$ref": "#/$defs/CViewAttributes" }],
      "properties": {
        "control-tag": { "type": "string", "description": "Control tag name or ID" },
        "default-value": { "$ref": "#/$defs/numericValue", "description": "Default/initial value (0.0 to 1.0)" },
        "min-value": { "$ref": "#/$defs/numericValue", "description": "Minimum value" },
        "max-value": { "$ref": "#/$defs/numericValue", "description": "Maximum value" },
        "wheel-inc-value": { "$ref": "#/$defs/numericValue", "description": "Mouse wheel increment" }
      }
    },

    "CParamDisplayAttributes": {
      "type": "object",
      "description": "CParamDisplay - Parameter display (inherits from CControl)",
      "allOf": [{ "$ref": "#/$defs/CControlAttributes" }],
      "properties": {
        "font": { "type": "string", "description": "Font reference name" },
        "font-color": { "$ref": "#/$defs/colorValue", "description": "Text color" },
        "back-color": { "$ref": "#/$defs/colorValue", "description": "Background color" },
        "frame-color": { "$ref": "#/$defs/colorValue", "description": "Frame/border color" },
        "shadow-color": { "$ref": "#/$defs/colorValue", "description": "Text shadow color" },
        "round-rect-radius": { "$ref": "#/$defs/numericValue", "description": "Corner radius for rounded rectangle style" },
        "frame-width": { "$ref": "#/$defs/numericValue", "description": "Frame/border width" },
        "text-alignment": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "description": "Horizontal text alignment"
        },
        "text-inset": { "$ref": "#/$defs/pointValue", "description": "Text inset from edges 'x, y'" },
        "text-shadow-offset": { "$ref": "#/$defs/pointValue", "description": "Text shadow offset 'x, y'" },
        "value-precision": { "$ref": "#/$defs/numericValue", "description": "Decimal places for value display" },
        "background-offset": { "$ref": "#/$defs/pointValue", "description": "Background bitmap offset" },
        "font-antialias": { "$ref": "#/$defs/booleanValue", "description": "Enable font anti-aliasing" },
        "style-3D-in": { "$ref": "#/$defs/booleanValue", "description": "3D inset style" },
        "style-3D-out": { "$ref": "#/$defs/booleanValue", "description": "3D outset style" },
        "style-no-frame": { "$ref": "#/$defs/booleanValue", "description": "Hide frame" },
        "style-no-text": { "$ref": "#/$defs/booleanValue", "description": "Hide text" },
        "style-no-draw": { "$ref": "#/$defs/booleanValue", "description": "Don't draw background" },
        "style-shadow-text": { "$ref": "#/$defs/booleanValue", "description": "Draw text shadow" },
        "style-round-rect": { "$ref": "#/$defs/booleanValue", "description": "Use rounded rectangle" },
        "text-rotation": { "$ref": "#/$defs/numericValue", "description": "Text rotation angle (0 to 360)" }
      }
    },

    "CTextLabelAttributes": {
      "type": "object",
      "description": "CTextLabel - Text label (inherits from CParamDisplay)",
      "allOf": [{ "$ref": "#/$defs/CParamDisplayAttributes" }],
      "properties": {
        "title": { "type": "string", "description": "Label text (use \\n for newlines)" },
        "truncate-mode": {
          "type": "string",
          "enum": ["none", "head", "tail"],
          "description": "Text truncation mode when too long"
        }
      }
    },

    "CMultiLineTextLabelAttributes": {
      "type": "object",
      "description": "CMultiLineTextLabel - Multi-line text label (inherits from CTextLabel)",
      "allOf": [{ "$ref": "#/$defs/CTextLabelAttributes" }],
      "properties": {
        "line-layout": {
          "type": "string",
          "enum": ["clip", "truncate", "wrap"],
          "description": "How lines are handled"
        },
        "auto-height": { "$ref": "#/$defs/booleanValue", "description": "Auto-adjust height to fit text" },
        "vertical-centered": { "$ref": "#/$defs/booleanValue", "description": "Vertically center text" }
      }
    },

    "CTextEditAttributes": {
      "type": "object",
      "description": "CTextEdit - Editable text field (inherits from CTextLabel)",
      "allOf": [{ "$ref": "#/$defs/CTextLabelAttributes" }],
      "properties": {
        "secure-style": { "$ref": "#/$defs/booleanValue", "description": "Password/secure input mode" },
        "immediate-text-change": { "$ref": "#/$defs/booleanValue", "description": "Notify on each keystroke" },
        "style-doubleclick": { "$ref": "#/$defs/booleanValue", "description": "Require double-click to edit" },
        "placeholder-title": { "type": "string", "description": "Placeholder text when empty" }
      }
    },

    "CSearchTextEditAttributes": {
      "type": "object",
      "description": "CSearchTextEdit - Search text field with clear button (inherits from CTextEdit)",
      "allOf": [{ "$ref": "#/$defs/CTextEditAttributes" }],
      "properties": {
        "clearmark-inset": { "$ref": "#/$defs/pointValue", "description": "Clear button inset 'x, y'" }
      }
    },

    "COptionMenuAttributes": {
      "type": "object",
      "description": "COptionMenu - Dropdown menu (inherits from CParamDisplay)",
      "allOf": [{ "$ref": "#/$defs/CParamDisplayAttributes" }],
      "properties": {
        "menu-popup-style": { "$ref": "#/$defs/booleanValue", "description": "Show as popup menu" },
        "menu-check-style": { "$ref": "#/$defs/booleanValue", "description": "Show checkmarks for selected items" }
      }
    },

    "CXYPadAttributes": {
      "type": "object",
      "description": "CXYPad - XY coordinate pad control (inherits from CParamDisplay)",
      "allOf": [{ "$ref": "#/$defs/CParamDisplayAttributes" }],
      "properties": {
        "handle-bitmap": { "type": "string", "description": "Handle/thumb bitmap reference" }
      }
    },

    "CTextButtonAttributes": {
      "type": "object",
      "description": "CTextButton - Text button (inherits from CControl)",
      "allOf": [{ "$ref": "#/$defs/CControlAttributes" }],
      "properties": {
        "kick-style": { "$ref": "#/$defs/booleanValue", "description": "Momentary (kick) vs toggle style" },
        "title": { "type": "string", "description": "Button text" },
        "font": { "type": "string", "description": "Font reference name" },
        "text-color": { "$ref": "#/$defs/colorValue", "description": "Normal text color" },
        "text-color-highlighted": { "$ref": "#/$defs/colorValue", "description": "Highlighted/pressed text color" },
        "gradient": { "type": "string", "description": "Normal state gradient reference" },
        "gradient-highlighted": { "type": "string", "description": "Highlighted state gradient reference" },
        "frame-color": { "$ref": "#/$defs/colorValue", "description": "Normal frame color" },
        "frame-color-highlighted": { "$ref": "#/$defs/colorValue", "description": "Highlighted frame color" },
        "round-radius": { "$ref": "#/$defs/numericValue", "description": "Corner radius" },
        "frame-width": { "$ref": "#/$defs/numericValue", "description": "Frame/border width" },
        "icon-text-margin": { "$ref": "#/$defs/numericValue", "description": "Space between icon and text" },
        "text-alignment": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "description": "Text alignment"
        },
        "icon": { "type": "string", "description": "Normal icon bitmap reference" },
        "icon-highlighted": { "type": "string", "description": "Highlighted icon bitmap reference" },
        "icon-position": {
          "type": "string",
          "enum": ["left", "center above text", "center below text", "right"],
          "description": "Icon position relative to text"
        }
      }
    },

    "CSegmentButtonAttributes": {
      "type": "object",
      "description": "CSegmentButton - Segmented button control (inherits from CControl)",
      "allOf": [{ "$ref": "#/$defs/CControlAttributes" }],
      "properties": {
        "style": {
          "type": "string",
          "enum": ["horizontal", "vertical", "horizontal-inverse", "vertical-inverse"],
          "description": "Segment arrangement style"
        },
        "selection-mode": {
          "type": "string",
          "enum": ["Single", "Single-Toggle", "Multiple"],
          "description": "Selection behavior"
        },
        "segment-names": { "type": "string", "description": "Comma-separated segment names" },
        "font": { "type": "string", "description": "Font reference name" },
        "text-color": { "$ref": "#/$defs/colorValue", "description": "Normal text color" },
        "text-color-highlighted": { "$ref": "#/$defs/colorValue", "description": "Selected text color" },
        "gradient": { "type": "string", "description": "Normal gradient reference" },
        "gradient-highlighted": { "type": "string", "description": "Selected gradient reference" },
        "frame-color": { "$ref": "#/$defs/colorValue", "description": "Frame color" },
        "round-radius": { "$ref": "#/$defs/numericValue", "description": "Corner radius" },
        "frame-width": { "$ref": "#/$defs/numericValue", "description": "Frame width" },
        "icon-text-margin": { "$ref": "#/$defs/numericValue", "description": "Icon to text margin" },
        "text-alignment": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "description": "Text alignment"
        },
        "truncate-mode": {
          "type": "string",
          "enum": ["none", "head", "tail"],
          "description": "Text truncation mode"
        }
      }
    },

    "CCheckBoxAttributes": {
      "type": "object",
      "description": "CCheckBox - Checkbox control (inherits from CControl)",
      "allOf": [{ "$ref": "#/$defs/CControlAttributes" }],
      "properties": {
        "title": { "type": "string", "description": "Checkbox label text" },
        "font": { "type": "string", "description": "Font reference name" },
        "font-color": { "$ref": "#/$defs/colorValue", "description": "Label text color" },
        "boxframe-color": { "$ref": "#/$defs/colorValue", "description": "Box frame color" },
        "boxfill-color": { "$ref": "#/$defs/colorValue", "description": "Box fill color" },
        "checkmark-color": { "$ref": "#/$defs/colorValue", "description": "Checkmark color" },
        "frame-width": { "$ref": "#/$defs/numericValue", "description": "Frame width" },
        "round-rect-radius": { "$ref": "#/$defs/numericValue", "description": "Corner radius" },
