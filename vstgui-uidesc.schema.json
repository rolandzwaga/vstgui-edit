        "CSearchTextEdit": { "$ref": "#/$defs/CSearchTextEditAttributes" },
        "CTextButton": { "$ref": "#/$defs/CTextButtonAttributes" },
        "COnOffButton": { "$ref": "#/$defs/COnOffButtonAttributes" },
