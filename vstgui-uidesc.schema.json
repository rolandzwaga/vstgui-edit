      "description": "Mapping of view class names to their attribute schemas",
      "type": "object",
      "properties": {
        "CView": { "$ref": "#/$defs/CViewAttributes" },
        "CViewContainer": { "$ref": "#/$defs/CViewContainerAttributes" },
        "CLayeredViewContainer": { "$ref": "#/$defs/CLayeredViewContainerAttributes" },
