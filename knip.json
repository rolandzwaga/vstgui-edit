{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "specs/**",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**"
  ],
  "ignoreDependencies": [
    "@fortawesome/fontawesome-svg-core"
  ],
  "ignoreExportsUsedInFile": true
}
